{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "error",
    "no-console": "warn",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": "error",
    "no-debugger": "error"
  },
  "plugins": ["react", "react-hooks", "typescript"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignore_patterns": [
    "dist/",
    "node_modules/",
    "prototype/"
  ]
}
